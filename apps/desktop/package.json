{
  "name": "iloathepdf",
  "private": true,
  "license": "MIT",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": ".venv\\Scripts\\python.exe -m pytest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check:recipe-steps": "node --experimental-strip-types scripts/check-recipe-steps.ts",
    "check:custom-recipes": "node --experimental-strip-types scripts/check-custom-recipes.ts",
    "check:version": "node --experimental-strip-types scripts/check-version.ts",
    "check:paths": "node --experimental-strip-types scripts/check-paths.ts",
    "build:sidecar": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "build:app": "npm run build:sidecar && tauri build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "pdfjs-dist": "~6.3.289",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "description": "Private, offline PDF and image toolkit"
}
