{
  "name": "iloathepdf-extension",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser extension: fit a file to an upload form, and collect page images into a PDF. Everything runs locally.",
  "scripts": {
    "build": "vite build --mode pages && vite build --mode content && vite build --mode background",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "zip": "node --experimental-strip-types scripts/zip.ts"
  },
  "dependencies": {
    "@iloathepdf/i18n": "*",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.6",
    "canvas": "^3.2.3",
    "fflate": "^0.8.3",
    "iloathepdf-web": "*",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
